{
  "actions": [
    {
      "description": "List visible non-archived conversations.",
      "name": "slack_list_conversations",
      "parameters": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      }
    },
    {
      "description": "Search visible undeleted messages.",
      "name": "slack_search_messages",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "default": 10,
            "maximum": 10,
            "minimum": 1,
            "type": "integer"
          },
          "query": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      }
    },
    {
      "description": "Read visible root messages newest first.",
      "name": "slack_get_conversation_history",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "conversation_id": {
            "type": "string"
          },
          "limit": {
            "default": 50,
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "conversation_id"
        ],
        "type": "object"
      }
    },
    {
      "description": "Read a visible root and its replies oldest first.",
      "name": "slack_get_thread",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "conversation_id": {
            "type": "string"
          },
          "root_message_id": {
            "type": "string"
          }
        },
        "required": [
          "conversation_id",
          "root_message_id"
        ],
        "type": "object"
      }
    },
    {
      "description": "Read one workspace directory entry.",
      "name": "slack_get_user",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "type": "string"
          }
        },
        "required": [
          "user_id"
        ],
        "type": "object"
      }
    }
  ],
  "domain": "slack",
  "interface_id": "slack.readonly.v1",
  "read_only": true
