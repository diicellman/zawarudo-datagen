        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "is_archived": {
          "default": false,
          "title": "Is Archived",
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "public_channel",
            "private_channel",
            "dm",
            "group_dm"
          ],
          "title": "Kind",
          "type": "string"
        },
        "member_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Member Ids",
          "type": "array"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "purpose": {
          "default": "",
          "maxLength": 2000,
          "title": "Purpose",
          "type": "string"
        },
        "topic": {
          "default": "",
          "maxLength": 2000,
          "title": "Topic",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Conversation",
      "type": "object"
    },
    "Message": {
